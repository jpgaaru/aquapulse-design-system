{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/designsystem", "destination": "/index.html" },
    { "source": "/designsystem/", "destination": "/index.html" },
    { "source": "/design-system", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
